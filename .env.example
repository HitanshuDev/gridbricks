# elexon | demo | csv | unavailable
DATA_MODE=elexon
# Docker passes DATA_MODE through as the frontend's initial source selection.
# For non-Docker frontend builds, set VITE_DEFAULT_SOURCE to match your backend.
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=4
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
FRONTEND_PORT=8080

# For deployed frontend builds, set VITE_API_BASE_URL to the backend origin
# (for example, https://your-api.example.com), without a trailing /api.
